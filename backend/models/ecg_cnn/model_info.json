        "sensitivity": 0.8325,
        "specificity": 0.9894,
        "precision": 0.9125,
        "f1": 0.8707
    },
    "test_evaluation_at_threshold_0_50": {
        "accuracy": 0.7859,
        "sensitivity": 0.8306,
        "specificity": 0.7801,
        "precision": 0.3264,
