{
    "project": "AI-Assisted ECG Screening System",
    "purpose": "Educational/research ECG screening prototype",
    "clinical_status": "NOT a clinical diagnostic device",
    "dataset": "MIT-BIH Arrhythmia Database",
    "input": {
        "type": "ECG beat segment",
        "samples": 187,
        "channels": 1
